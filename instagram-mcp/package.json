{
  "name": "instagram-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Instagram API. Works with Claude and ChatGPT (stdio and streamable HTTP).",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "instagram-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsc --watch",
    "test": "node --test dist/test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
