# Instagram API with Instagram Login (Business or Creator account)
INSTAGRAM_ACCESS_TOKEN=
# Optional. Defaults to "me".
INSTAGRAM_USER_ID=me
# Optional. Defaults to v23.0
INSTAGRAM_API_VERSION=v23.0

# HTTP mode only
PORT=3000
# If set, every /mcp request must send "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=
# Set to "1" to expose write tools (publish, reply, hide, delete). Off by default.
INSTAGRAM_ENABLE_WRITES=0
